# Porta do servidor (a central da estação usa a que ela escolher)
PORT=3000
# Etapa 3: metadados no SQLite e fotos no object storage (SeaweedFS, S3)
DB_ARQUIVO=dados/inspecao.db
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=fotos
S3_KEY=inspecao
S3_SECRET=inspecao-segredo
# Etapa 4: limite de fotos por minuto de cada câmera
LIMITE_FOTOS_POR_MINUTO=600
